{
  "name": "@brightcove/react-native-player",
  "version": "0.0.0",
  "private": true,
  "description": "React Native bridge for the Brightcove native player SDKs",
  "main": "src/index",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "codegenConfig": {
    "name": "BrightcovePlayerViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.brightcove.reactnativeplayer"
    },
    "ios": {
      "components": {
        "BrightcovePlayerView": {
          "className": "BrightcovePlayerView"
        }
      }
    }
  },
  "author": "Brightcove",
  "license": "Apache-2.0",
  "homepage": "https://www.brightcove.com/",
  "dependencies": {
    "@brightcove/web-sdk": "^1.3.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.8.3"
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
